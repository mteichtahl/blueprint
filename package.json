{
  "name": "blueprint",
  "private": true,
  "description": "BMG App — Blueprint Music Group platform (AWS, TypeScript, CDK)",
  "bin": {
    "blueprint": "packages/cli/bin/blueprint.mjs"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "infra"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "policy": "npm run --workspace @bmg/ci-policy check -- .github/workflows",
    "synth": "npm run --workspace @bmg/infra synth",
    "blueprint": "node packages/cli/bin/blueprint.mjs",
    "cli:link": "npm link"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
